{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [
    ".env",
    "apps/docs/content/**",
    "apps/blog/content/**",
    "apps/site/content/**",
    "apps/site/src/app/**",
    "packages/ui/scripts/generate-search-index.mjs"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "cache/**",
        "dist/**"
      ],
      "env": [
        "MIXEDBREAD_API_KEY",
        "SENTRY_AUTH_TOKEN",
        "ENABLE_DOCS_SUBDOMAIN_PROXY",
        "NEXT_SITE_ORIGIN",
        "NEXT_DOCS_ORIGIN",
        "NEXT_BLOG_ORIGIN"
      ]
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    },
    "check": {
      "cache": false
    },
    "types:check": {
      "dependsOn": [
        "^types:check"
      ]
    },
    "lint:links": {},
    "lint:agent-ready": {},
    "lint:external-links": {},
    "lint:code": {},
    "lint:spellcheck": {}
  }
}
