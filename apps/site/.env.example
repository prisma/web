# Mixedbread API Configuration
# Required for the search functionality to work
# Get your API key from: https://www.mixedbread.ai/
MIXEDBREAD_API_KEY=your_mixedbread_api_key_here

# Base URL for the site (optional, defaults based on environment)
# NEXT_PUBLIC_PRISMA_URL=https://www.prisma.io

# Vercel URL (automatically set in Vercel deployments)
# VERCEL_URL=

# Allowed development origins (optional, defaults to localhost,127.0.0.1,192.168.1.48)
# ALLOWED_DEV_ORIGINS=localhost,127.0.0.1

# Extension directory submissions (/extensions/submit)
# A GitHub token with "contents: write" and "pull requests: write" on the target repo.
# Without it the form falls back to a prefilled GitHub issue link.
# GITHUB_EXTENSIONS_TOKEN=
# EXTENSIONS_REPO=prisma/web
# EXTENSIONS_BASE_BRANCH=main

# The /apps gallery reads the Compute template manifest from the latest branch
# of prisma/prisma-examples. Point a preview at another branch, such as a
# template under review, with its raw templates.json URL.
# TEMPLATE_MANIFEST_URL=https://raw.githubusercontent.com/prisma/prisma-examples/<branch>/compute/templates.json
