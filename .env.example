# Optional Composer integrations: mixedbread,brevo,extensions,linear.
# Leave empty to run pages and assets without external credential bindings.
COMPOSER_INTEGRATIONS=
# Enabled integrations require real values in the project's Preview/Production
# environment for deploy. Local dev uses placeholders for enabled, unset secrets.
MIXEDBREAD_API_KEY=
BREVO_API_KEY=
GITHUB_EXTENSIONS_TOKEN=
GITHUB_WEBHOOK_SECRET=
BOT_TOKEN_GITHUB_PR_LINEAR_WEBHOOK=
LINEAR_API_KEY=

# Public NEXT_PUBLIC_* values are build-time settings. Copy the corresponding
# values from each app's Vercel configuration before a production build.
