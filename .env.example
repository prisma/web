# Optional runtime integrations for Composer. Pages and assets work without
# these values; Composer uses local placeholders for unset secrets in dev.
MIXEDBREAD_API_KEY=
BREVO_API_KEY=
GITHUB_EXTENSIONS_TOKEN=
GITHUB_WEBHOOK_SECRET=
BOT_TOKEN_GITHUB_PR_LINEAR_WEBHOOK=
LINEAR_API_KEY=

# Public NEXT_PUBLIC_* values are build-time settings. Copy the corresponding
# values from each app's Vercel configuration before a production build.
