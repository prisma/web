+// One-off script to print the FAQPage JSON-LD that the Data Guide will emit
+// for the 5-ways-to-host-postgresql page, so a reviewer can eyeball the
+// shape and confirm every answer matches the visible page text.
+//
+// Run with: node --experimental-strip-types scripts/check-faq-jsonld.mjs
+import { readFileSync } from 'node:fs'
+import { fileURLToPath } from 'node:url'
+import { dirname, resolve } from 'node:path'
+import { extractFaqEntries } from '../src/utils/extractFaq.ts'
+import { faqStructuredDataNode } from '../src/utils/structuredData.ts'
+
+const here = dirname(fileURLToPath(import.meta.url))
+const mdxPath = resolve(here, '../content/04-postgresql/03-5-ways-to-host-postgresql.mdx')
+const mdx = readFileSync(mdxPath, 'utf8')
+const faqs = extractFaqEntries(mdx)
+
+const url = 'https://www.prisma.io/dataguide/postgresql/5-ways-to-host-postgresql'
+const name = '5 ways to host PostgreSQL databases'
+
+const node = faqStructuredDataNode(url, name, faqs)
+process.stdout.write(JSON.stringify({ '@context': 'https://schema.org', ...node }, null, 2))
+process.stdout.write('\n')
