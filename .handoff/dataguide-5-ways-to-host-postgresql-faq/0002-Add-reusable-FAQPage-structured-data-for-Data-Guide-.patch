diff --git a/src/utils/extractFaq.ts b/src/utils/extractFaq.ts
new file mode 100644
index 0000000..a6a6fe2
--- /dev/null
+++ b/src/utils/extractFaq.ts
@@ -0,0 +1,158 @@
+// Parse an MDX article body's FAQ section into { question, answer } pairs
+// suitable for FAQPage structured data (schema.org).
+//
+// Supported FAQ shapes (both are already used across the Data Guide):
+//   1. H3 pairs under an H2 heading:
+//        ## Frequently asked questions
+//        ### Question text
+//        Answer paragraph(s)...
+//        ### Next question
+//        ...
+//   2. <details>/<summary> pairs under an H2 heading:
+//        ## FAQ
+//        <details>
+//        <summary>Question text</summary>
+//        Answer paragraph(s)...
+//        </details>
+//
+// Answers are flattened to plain text, matching the visible page text word
+// for word with Markdown link and code markup stripped to their words. This
+// is what Google's FAQPage schema expects as the acceptedAnswer `text`.
+
+export type FaqEntry = { question: string; answer: string }
+
+const FAQ_HEADING_RE = /^## +(?:Frequently\s+asked\s+questions|FAQ)\s*$/im
+const NEXT_H2_RE = /^## +/m
+
+/**
+ * Flatten MDX / Markdown prose to plain text, preserving the words the
+ * reader sees but dropping link URLs, code fences, HTML tags, and MDX
+ * components. Intended for FAQPage acceptedAnswer.text values.
+ */
+export function toPlainText(input: string): string {
+  let text = input
+
+  // Drop fenced code blocks (``` ... ``` and ~~~ ... ~~~). Google's FAQ
+  // schema wants a short plain-text answer, not literal code.
+  text = text.replace(/```[\s\S]*?```/g, ' ').replace(/~~~[\s\S]*?~~~/g, ' ')
+
+  // Drop MDX / JSX components (self-closing and paired). We leave common
+  // inline HTML (<a>, <strong>, <br/>) to the HTML-tag strip below so their
+  // text content survives.
+  text = text.replace(/<([A-Z][A-Za-z0-9]*)\b[^>]*\/>/g, ' ')
+  text = text.replace(/<([A-Z][A-Za-z0-9]*)\b[^>]*>[\s\S]*?<\/\1>/g, ' ')
+
+  // Markdown links: [text](url) -> text. Supports absolute and relative URLs.
+  text = text.replace(/\[([^\]]+)\]\((?:[^()\s]+|\([^)]*\))\)/g, '$1')
+
+  // Reference-style link definitions on their own line: [id]: url
+  text = text.replace(/^\[[^\]]+\]:\s+\S+.*$/gm, ' ')
+
+  // Images: ![alt](url) -> alt (usually empty inside FAQ answers)
+  text = text.replace(/!\[([^\]]*)\]\([^)]*\)/g, '$1')
+
+  // Inline code: `code` -> code
+  text = text.replace(/`([^`]+)`/g, '$1')
+
+  // Bold / italic markers (**x**, __x__, *x*, _x_) around visible words
+  text = text.replace(/\*\*([^*]+)\*\*/g, '$1')
+  text = text.replace(/__([^_]+)__/g, '$1')
+  text = text.replace(/(^|[\s(])\*([^*\n]+)\*/g, '$1$2')
+  text = text.replace(/(^|[\s(])_([^_\n]+)_/g, '$1$2')
+
+  // HTML entities we see in Data Guide copy
+  text = text
+    .replace(/&nbsp;/g, ' ')
+    .replace(/&amp;/g, '&')
+    .replace(/&quot;/g, '"')
+    .replace(/&#39;|&apos;/g, "'")
+    .replace(/&lt;/g, '<')
+    .replace(/&gt;/g, '>')
+
+  // Strip remaining HTML tags, keep their text content
+  text = text.replace(/<[^>]+>/g, ' ')
+
+  // Collapse whitespace
+  text = text.replace(/\s+/g, ' ').trim()
+
+  return text
+}
+
+/**
+ * Strip the YAML frontmatter block (--- ... ---) from the top of an MDX file
+ * so the parser only sees the body.
+ */
+function stripFrontmatter(mdx: string): string {
+  if (!mdx.startsWith('---')) return mdx
+  const end = mdx.indexOf('\n---', 3)
+  if (end === -1) return mdx
+  return mdx.slice(end + 4).replace(/^\r?\n/, '')
+}
+
+/**
+ * Locate the FAQ section (## Frequently asked questions or ## FAQ) within a
+ * stripped MDX body and return its content, excluding the heading itself.
+ * Returns null when no FAQ section is present.
+ */
+function findFaqSection(body: string): string | null {
+  const match = FAQ_HEADING_RE.exec(body)
+  if (!match) return null
+  const start = match.index + match[0].length
+  const rest = body.slice(start)
+  const nextH2 = NEXT_H2_RE.exec(rest)
+  const sectionEnd = nextH2 ? nextH2.index : rest.length
+  return rest.slice(0, sectionEnd)
+}
+
+/**
+ * Parse H3-headed Q/A pairs out of an FAQ section.
+ * Each `### question` is followed by its answer until the next `###` or end.
+ */
+function parseH3Faqs(section: string): FaqEntry[] {
+  const entries: FaqEntry[] = []
+  const parts = section.split(/^### +/m)
+  // parts[0] is pre-first-H3 text; skip it.
+  for (let i = 1; i < parts.length; i++) {
+    const chunk = parts[i]
+    const newline = chunk.indexOf('\n')
+    const question = (newline === -1 ? chunk : chunk.slice(0, newline)).trim()
+    const answer = newline === -1 ? '' : chunk.slice(newline + 1)
+    const q = toPlainText(question)
+    const a = toPlainText(answer)
+    if (q && a) entries.push({ question: q, answer: a })
+  }
+  return entries
+}
+
+/**
+ * Parse <details><summary>Q</summary>A</details> pairs out of an FAQ section.
+ */
+function parseDetailsFaqs(section: string): FaqEntry[] {
+  const entries: FaqEntry[] = []
+  const detailsRe = /<details>([\s\S]*?)<\/details>/g
+  let match: RegExpExecArray | null
+  while ((match = detailsRe.exec(section)) !== null) {
+    const inner = match[1]
+    const summaryRe = /<summary>([\s\S]*?)<\/summary>/
+    const summary = summaryRe.exec(inner)
+    if (!summary) continue
+    const question = toPlainText(summary[1])
+    const answer = toPlainText(inner.replace(summaryRe, ' '))
+    if (question && answer) entries.push({ question, answer })
+  }
+  return entries
+}
+
+/**
+ * Extract an article's FAQ entries from its raw MDX source. Returns an empty
+ * array when the page has no FAQ section (so callers can safely skip adding
+ * FAQPage structured data).
+ */
+export function extractFaqEntries(mdx: string): FaqEntry[] {
+  const body = stripFrontmatter(mdx)
+  const section = findFaqSection(body)
+  if (section === null) return []
+  const h3 = parseH3Faqs(section)
+  if (h3.length > 0) return h3
+  return parseDetailsFaqs(section)
+}
