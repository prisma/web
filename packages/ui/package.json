{
  "name": "@prisma-docs/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./postcss.config": "./postcss.config.mjs",
    "./lib/*": "./src/lib/*.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./components/*": "./src/components/*.tsx",
    "./data/*": "./src/data/*.ts",
    "./styles": "./src/styles/globals.css",
    "./search.css": "./src/styles/search.css"
  },
  "scripts": {
    "check": "oxfmt . --write && oxlint . --fix && pnpm run test",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\"",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@mixedbread/sdk": "catalog:",
    "@prisma/eclipse": "workspace:*",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "feed": "catalog:",
    "fumadocs-core": "catalog:",
    "fumadocs-ui": "catalog:",
    "lucide-react": "catalog:",
    "mdast-util-to-string": "4.0.0",
    "react-intersection-observer": "^11.0.1",
    "remark-parse": "11.0.0",
    "tailwind-merge": "catalog:",
    "unified": "11.0.5",
    "vaul": "catalog:",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "next": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "next": "catalog:",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
