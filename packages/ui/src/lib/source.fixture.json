    },
    { "name": "grok referrer", "input": { "referrer": "https://grok.com/" }, "expected": "grok" },
    {
      "name": "deepseek referrer",
      "input": { "referrer": "https://chat.deepseek.com/" },
      "expected": "other_ai"
    },
    {
      "name": "duck.ai referrer",
      "input": { "referrer": "https://duck.ai/" },
      "expected": "other_ai"
    },
    {
      "name": "gravity referrer",
      "input": { "referrer": "https://api.trygravity.ai/" },
      "expected": "other_ai"
    },
    {
      "name": "google.com referrer",
      "input": { "referrer": "https://www.google.com/" },
      "expected": "google"
    },
    {
      "name": "google.de referrer",
      "input": { "referrer": "https://www.google.de/" },
      "expected": "google"
    },
    {
      "name": "google.co.uk referrer",
      "input": { "referrer": "https://www.google.co.uk/" },
      "expected": "google"
    },
    {
      "name": "google.com.br referrer",
      "input": { "referrer": "https://www.google.com.br/" },
      "expected": "google"
    },
    {
      "name": "mail.google.com is not google",
      "input": { "referrer": "https://mail.google.com/" },
      "expected": "other"
    },
    {
      "name": "docs.google.com is not google",
      "input": { "referrer": "https://docs.google.com/" },
      "expected": "other"
    },
    {
      "name": "cloud.google.com is not google",
      "input": { "referrer": "https://cloud.google.com/" },
      "expected": "other"
    },
    {
      "name": "accounts.google.com is skipped",
      "input": { "referrer": "https://accounts.google.com/" },
      "expected": "direct"
    },
    {
      "name": "lookalike google host is other",
      "input": { "referrer": "https://google.evil.example/" },
      "expected": "other"
    },
    {
      "name": "bing referrer",
      "input": { "referrer": "https://www.bing.com/" },
      "expected": "bing"
    },
    {
      "name": "cn.bing referrer",
      "input": { "referrer": "https://cn.bing.com/" },
