    },
    {
      "name": "ChatGPT Android app referrer",
      "input": { "referrer": "android-app://com.openai.chatgpt/" },
      "expected": "chatgpt"
    },
    {
      "name": "other Android app referrer",
      "input": { "referrer": "android-app://com.google.android.gm/" },
      "expected": "other"
    },
    {
      "name": "invalid referrer is no signal",
      "input": { "referrer": "not a url" },
      "expected": "direct"
    },
    {
      "name": "referrer with credentials is no signal",
      "input": { "referrer": "https://user:pass@claude.ai/" },
      "expected": "direct"
    },
    { "name": "nothing is direct", "input": {}, "expected": "direct" }
  ],
  "params": [
    {
      "name": "web hand-off with both params",
      "query": "acq_source=chatgpt&first_acq_source=gemini&utm_source=chatgpt.com",
      "expected": { "first": "gemini", "last": "chatgpt" }
    },
    {
      "name": "first touch from first_utm when no first_acq_source",
      "query": "utm_source=newsletter&first_utm_source=chatgpt.com",
      "expected": { "first": "chatgpt", "last": "other" }
    },
    {
      "name": "first click id",
      "query": "utm_source=docs&first_gclid=abc",
      "expected": { "first": "google", "last": "direct" }
    },
    {
      "name": "first falls back to last",
      "query": "utm_source=chatgpt.com",
      "expected": { "first": "chatgpt", "last": "chatgpt" }
    },
    {
      "name": "first placement falls back to last",
      "query": "utm_source=chatgpt.com&first_utm_source=docs",
      "expected": { "first": "chatgpt", "last": "chatgpt" }
    },
    {
      "name": "referrer belongs to the last touch",
      "query": "",
      "referrer": "https://gemini.google.com/",
      "expected": { "first": "gemini", "last": "gemini" }
    },
    {
      "name": "forwarded direct is not a touch",
      "query": "acq_source=direct&first_acq_source=direct",
      "expected": { "first": "direct", "last": "direct" }
    },
    { "name": "nothing", "query": "", "expected": { "first": "direct", "last": "direct" } }
  ],
  "merge": [
    {
      "name": "first touch sets both",
      "existing": null,
      "touch": { "first": "chatgpt", "last": "chatgpt" },
      "expected": { "first": "chatgpt", "last": "chatgpt" }
    },
    {
      "name": "later touch moves last only",
      "existing": { "first": "chatgpt", "last": "chatgpt" },
      "touch": { "first": "google", "last": "google" },
      "expected": { "first": "chatgpt", "last": "google" }
    },
    {
      "name": "direct touch changes nothing",
      "existing": { "first": "chatgpt", "last": "google" },
      "touch": { "first": "direct", "last": "direct" },
      "expected": { "first": "chatgpt", "last": "google" }
    },
    {
      "name": "direct touch with nothing stored stores nothing",
      "existing": null,
      "touch": { "first": "direct", "last": "direct" },
      "expected": null
    },
    {
      "name": "forwarded first fills an empty record",
      "existing": null,
      "touch": { "first": "gemini", "last": "chatgpt" },
      "expected": { "first": "gemini", "last": "chatgpt" }
    },
    {
      "name": "stored first wins over a forwarded first",
      "existing": { "first": "claude", "last": "claude" },
      "touch": { "first": "gemini", "last": "chatgpt" },
      "expected": { "first": "claude", "last": "chatgpt" }
    },
    {
      "name": "invalid stored values are dropped",
      "existing": { "first": "evil", "last": "direct" },
      "touch": { "first": "bing", "last": "bing" },
      "expected": { "first": "bing", "last": "bing" }
    }
  ]
}
