{
  "version": 1,
  "about": "Test vectors for classifySource v1. The same file is used by prisma/web (packages/ui/src/lib/source.fixture.json) and prisma/pdp-control-plane (packages/contracts/control-plane/source.fixture.json). Keep the vectors in both copies the same; each repository formats its own copy.",
  "classify": [
    {
      "name": "ChatGPT citation utm",
      "input": { "utmSource": "chatgpt.com" },
      "expected": "chatgpt"
    },
    {
      "name": "ChatGPT ads utm",
      "input": { "utmSource": "chatgpt", "utmMedium": "paid", "clickIds": ["oppref"] },
      "expected": "chatgpt"
    },
    { "name": "openai utm", "input": { "utmSource": "openai" }, "expected": "chatgpt" },
    {
      "name": "utm is case-insensitive and trimmed",
      "input": { "utmSource": " ChatGPT.com " },
      "expected": "chatgpt"
    },
    { "name": "claude utm", "input": { "utmSource": "claude.ai" }, "expected": "claude" },
    { "name": "anthropic utm", "input": { "utmSource": "anthropic" }, "expected": "claude" },
    { "name": "gemini utm", "input": { "utmSource": "gemini" }, "expected": "gemini" },
    {
      "name": "perplexity utm contains",
      "input": { "utmSource": "perplexity.ai" },
      "expected": "perplexity"
    },
    {
      "name": "copilot utm contains",
      "input": { "utmSource": "m365copilot" },
      "expected": "copilot"
    },
    { "name": "grok utm", "input": { "utmSource": "grok" }, "expected": "grok" },
    {
      "name": "gravity utm is other_ai",
      "input": { "utmSource": "gravity" },
      "expected": "other_ai"
    },
    {
      "name": "google utm",
      "input": { "utmSource": "google", "utmMedium": "cpc" },
      "expected": "google"
    },
    { "name": "bing utm", "input": { "utmSource": "bing" }, "expected": "bing" },
    { "name": "reddit utm", "input": { "utmSource": "reddit" }, "expected": "social" },
    { "name": "x utm", "input": { "utmSource": "x" }, "expected": "social" },
    { "name": "vscode utm", "input": { "utmSource": "vscode" }, "expected": "dev_tool" },
    {
      "name": "create-db claim tag",
      "input": { "utmSource": "create-db-frontend" },
      "expected": "dev_tool"
    },
    {
      "name": "cli medium wins over a free-form source",
      "input": { "utmSource": "my-project", "utmMedium": "cli" },
      "expected": "dev_tool"
    },
    {
      "name": "claim_button medium",
      "input": { "utmSource": "create-db", "utmMedium": "claim_button" },
      "expected": "dev_tool"
    },
    {
      "name": "cli medium wins over an AI source",
      "input": { "utmSource": "chatgpt.com", "utmMedium": "cli" },
      "expected": "dev_tool"
    },
    { "name": "vercel utm", "input": { "utmSource": "vercel" }, "expected": "vercel" },
    {
      "name": "unknown utm source is other",
      "input": { "utmSource": "newsletter" },
      "expected": "other"
    },
    {
      "name": "docs placement falls through to direct",
      "input": { "utmSource": "docs" },
      "expected": "direct"
    },
    {
      "name": "docs placement falls through to the referrer",
      "input": { "utmSource": "docs", "referrer": "https://gemini.google.com/" },
      "expected": "gemini"
    },
    { "name": "docs-v6 placement", "input": { "utmSource": "docs-v6" }, "expected": "direct" },
    { "name": "website placement", "input": { "utmSource": "website" }, "expected": "direct" },
    { "name": "kapa placement", "input": { "utmSource": "kapa" }, "expected": "direct" },
    {
      "name": "templates medium is a placement",
      "input": { "utmSource": "github", "utmMedium": "templates" },
      "expected": "direct"
    },
    { "name": "gclid alone", "input": { "clickIds": ["gclid"] }, "expected": "google" },
    { "name": "wbraid alone", "input": { "clickIds": ["wbraid"] }, "expected": "google" },
    { "name": "msclkid alone", "input": { "clickIds": ["msclkid"] }, "expected": "bing" },
    { "name": "oppref alone", "input": { "clickIds": ["oppref"] }, "expected": "chatgpt" },
    {
      "name": "fbclid alone names no source",
      "input": { "clickIds": ["fbclid"] },
      "expected": "direct"
    },
    {
      "name": "utm wins over a click id",
      "input": { "utmSource": "newsletter", "clickIds": ["gclid"] },
      "expected": "other"
    },
    {
      "name": "click id wins over the referrer",
      "input": { "clickIds": ["gclid"], "referrer": "https://claude.ai/" },
      "expected": "google"
    },
    {
      "name": "utm wins over the referrer",
      "input": { "utmSource": "chatgpt.com", "referrer": "https://www.google.com/" },
      "expected": "chatgpt"
    },
    {
      "name": "forwarded source wins over utm",
      "input": { "forwarded": "gemini", "utmSource": "chatgpt.com" },
      "expected": "gemini"
    },
    {
      "name": "forwarded direct is ignored",
      "input": { "forwarded": "direct", "utmSource": "chatgpt.com" },
      "expected": "chatgpt"
    },
    {
      "name": "forwarded unknown is ignored",
      "input": { "forwarded": "unknown" },
      "expected": "direct"
    },
    {
      "name": "forwarded value outside the list is ignored",
      "input": { "forwarded": "https://evil.example/", "referrer": "https://claude.ai/" },
      "expected": "claude"
    },
    {
      "name": "chatgpt.com referrer",
      "input": { "referrer": "https://chatgpt.com/" },
      "expected": "chatgpt"
    },
    {
      "name": "chat.openai.com referrer",
      "input": { "referrer": "https://chat.openai.com/" },
      "expected": "chatgpt"
    },
    {
      "name": "claude.ai referrer with a chat path keeps only the value",
      "input": { "referrer": "https://claude.ai/chat/0b6f1c2e-secret-path?q=private" },
      "expected": "claude"
    },
    {
      "name": "gemini.google.com referrer is gemini, not google",
      "input": { "referrer": "https://gemini.google.com/" },
      "expected": "gemini"
    },
    {
      "name": "perplexity referrer",
      "input": { "referrer": "https://www.perplexity.ai/" },
      "expected": "perplexity"
    },
    {
