{
  "name": "prisma-docs-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "check": "turbo run check && pnpm run test",
    "test": "node --test \"scripts/**/*.test.ts\"",
    "links:fix": "node scripts/fix-internal-links.ts",
    "types:check": "turbo run types:check",
    "generate:management-api-docs": "pnpm --filter docs run generate:management-api-docs",
    "lint:links": "turbo run lint:links --filter=docs",
    "lint:external-links": "turbo run lint:external-links --filter=docs",
    "lint:code": "turbo run lint:code --filter=docs",
    "lint:spellcheck": "turbo run lint:spellcheck --filter=docs",
    "test:search": "pnpm --filter docs exec tsx ../../packages/ui/scripts/test-search.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.3.4"
}
