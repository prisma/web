{
  "name": "prisma-docs-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm composer:build && prisma dev module.ts",
    "check": "turbo run check && pnpm run test",
    "test": "node --test \"scripts/**/*.test.ts\"",
    "links:fix": "node scripts/fix-internal-links.ts",
    "types:check": "turbo run types:check",
    "generate:management-api-docs": "pnpm --filter docs run generate:management-api-docs",
    "lint:links": "turbo run lint:links --filter=docs",
    "lint:external-links": "turbo run lint:external-links --filter=docs",
    "lint:code": "turbo run lint:code --filter=docs",
    "lint:spellcheck": "turbo run lint:spellcheck --filter=docs",
    "test:search": "pnpm --filter docs exec tsx ../../packages/ui/scripts/test-search.ts",
    "dev:turbo": "turbo run dev",
    "composer:build": "node composer/build.ts",
    "composer:dev": "prisma dev module.ts",
    "composer:check": "tsc --noEmit -p composer/tsconfig.json && node --test \"composer/**/*.test.ts\"",
    "composer:smoke": "node composer/smoke.ts"
  },
  "dependencies": {
    "@prisma/composer": "0.29.1",
    "@prisma/composer-prisma-cloud": "0.29.1",
    "arktype": "2.2.3",
    "path-to-regexp": "6.3.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "@types/node": "catalog:",
    "bun": "1.4.3",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "prisma": "8.0.0-rc.22",
    "turbo": "catalog:",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.3.4"
}
