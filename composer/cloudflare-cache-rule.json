{
  "description": "Prisma preview — defer caching to origin",
  "expression": "(http.host eq \"prisma.sorenbs.com\")",
  "action": "set_cache_settings",
  "action_parameters": {
    "cache": true,
    "edge_ttl": {
      "mode": "bypass_by_default"
    },
    "browser_ttl": {
      "mode": "respect_origin"
    },
    "vary": {
      "default": {
        "action": "passthrough"
      }
    }
  }
}
